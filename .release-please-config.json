{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "chore", "section": "Miscellaneous Chores" },
    { "type": "docs", "section": "Docs" }
  ],
  "pull-request-header": ":rotating_light: There are changes ready for release :rocket:\n\nℹ Merge this PR once the team confirms the release is ready.\n",
  "group-pull-request-title-pattern": "chore: release ${branch}",
  "include-component-in-tag": true,
  "bootstrap-sha": "875842bc783d6bd1592f6e5204d9735709df3a93",
  "packages": {
    "packages/vgv_ai_cli": {
      "release-type": "dart",
      "component": "vgv_ai_cli",
      "changelog-path": "CHANGELOG.md",
      "version-file": "pubspec.yaml"
    },
    "packages/plugin_source": {
      "release-type": "dart",
      "component": "plugin_source",
      "changelog-path": "CHANGELOG.md",
      "version-file": "pubspec.yaml"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "vgv_ai",
      "components": ["vgv_ai_cli", "plugin_source"]
    }
  ]
}
