{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "chore", "section": "Miscellaneous Chores" },
    { "type": "docs", "section": "Docs" }
  ],
  "pull-request-header": ":rotating_light: There are changes ready for release :rocket:\n\nℹ Merge this PR once the team confirms the release is ready.\n",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "packages": {
    "packages/vgv_ai_cli": {
      "release-type": "dart",
      "component": "vgv_ai_cli",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": ["lib/src/version.dart"]
    },
    "packages/vgv_ai_plugins": {
      "release-type": "dart",
      "component": "vgv_ai_plugins",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
