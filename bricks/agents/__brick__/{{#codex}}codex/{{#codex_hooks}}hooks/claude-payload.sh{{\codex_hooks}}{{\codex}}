# Runs a hook script written for Claude Code against a Codex payload.
#
# Most of the payload already matches: Codex sends the same session_id, cwd,
# hook_event_name, tool_name and tool_input.command, and names its shell tool
# Bash and its MCP tools mcp__<server>__<tool> exactly as Claude Code does.
# A file edit is where the two part ways. Claude Code sends one Edit or Write
# per file, naming it in tool_input.file_path. Codex sends one apply_patch for
# the whole change, with the patch text in tool_input.command and no file named
# anywhere a script can read it.
#
# So this translates that one case: it reads the files out of the patch
# headers and runs the script once per file, as the Edit or Write Claude Code
# would have sent. Every other payload is passed through as it came.
#
# Usage: bash claude-payload.sh '<the command to run>'
#
# Written by `vgv_ai install`. Edits here are overwritten on the next run.

set -uo pipefail

wrapped=$1
payload=$(cat)

run() {
  printf '%s' "$1" | sh -c "$wrapped"
}

# Without jq there is nothing to translate with, so the script gets the payload
# as it came. Every VGV hook script already skips itself when jq is missing.
if ! command -v jq > /dev/null 2>&1; then
  run "$payload"
  exit $?
fi

# Each file this payload is about, as the tool Claude Code would have named
# for it: an added file is a Write, a changed or renamed one an Edit. A
# payload that already names a file keeps its own tool name.
#
# A patch header names a file relative to the session root when the model
# wrote it that way, so each path is resolved against the payload's own cwd
# rather than wherever this process happens to be running.
#
# The regexes use character classes so this holds no backslash before a
# newline, which mason would strip when it renders the file.
edits=$(printf '%s' "$payload" | jq -r '
  . as $payload
  | (($payload.cwd // ".") | rtrimstr("/")) as $cwd
  | def absolute: if startswith("/") then . else $cwd + "/" + . end;
    [
      (if $payload.tool_input.file_path
         then {
           name: $payload.tool_name,
           path: ($payload.tool_input.file_path | absolute),
         }
         else empty end),
      (($payload.tool_input.command // "")
        | scan("(?m)^[*][*][*] (Add File|Update File|Move to): (.+)$")
        | {
          name: (if .[0] == "Add File" then "Write" else "Edit" end),
          path: (.[1] | absolute),
        })
    ]
  | unique_by(.path)
  | .[]
  | "\(.name)\t\(.path)"
' 2>/dev/null)

status=0
ran=0
while IFS=$'\t' read -r name path; do
  # A deleted file, or the old name of a renamed one, is no longer there to
  # analyze or format, so it drops out here rather than failing the script.
  if [ -n "$path" ] && [ -f "$path" ]; then
    ran=1
    edit=$(printf '%s' "$payload" | jq --arg name "$name" --arg path "$path" '.tool_name = $name | .tool_input.file_path = $path')
    run "$edit" || status=$?
  fi
done <<< "$edits"

# This payload is about no file that exists, so it needs no translating.
if [ "$ran" -eq 0 ]; then
  run "$payload" || status=$?
fi

exit $status
