{
  "description": "Fixture hooks",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/warn.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash analyze.sh", "timeout": 30 },
          { "type": "command", "command": "bash format.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": 7,
        "hooks": [
          { "command": "bash typeless.sh" },
          { "type": "prompt", "command": "Summarize the session." }
        ]
      }
    ],
    "Malformed": "not a list",
    "EmptyCommands": [
      { "matcher": "Bash", "hooks": [] },
      { "matcher": "Bash", "hooks": [{ "type": "command" }] },
      "not an object"
    ]
  }
}
