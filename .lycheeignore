# Lychee ignore patterns
# See https://github.com/lycheeverse/lychee for documentation

# Dart string interpolation quoted in docs, picked up as literal link text
\$\{

# Private sibling repositories the workflow token cannot read
^https://github\.com/VeryGoodOpenSource/vgv-wingspan

# release-please CHANGELOG compare links, whose tags exist only once the release PR merges
^https://github\.com/VeryGoodOpenSource/vgv_ai_cli/compare/
